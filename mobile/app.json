{
  "expo": {
    "name": "ClearFeed",
    "slug": "clearfeed",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clearfeed.app"
    },
    "android": {
      "package": "com.clearfeed.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ClearFeed to access your camera to scan QR codes for offline mesh pairing."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ClearFeed to access your photos to select avatars and post media."
        }
      ]
    ]
  }
}
