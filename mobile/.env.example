# Clearfeed Android Mobile Environment Configuration

# Backend API target URL (Leave empty to use automatic LAN IP discovery or cloud default)
EXPO_PUBLIC_API_URL=https://your-api.up.railway.app/api

# Fallback cloud API endpoint
EXPO_PUBLIC_FALLBACK_URL=https://your-api.up.railway.app/api

# Local development machine Wi-Fi IPv4 address (e.g. 192.168.1.50)
# Used when debugging on physical Android devices via Metro
EXPO_PUBLIC_DEV_HOST_IP=192.168.1.90
