# Server Port (default 5180)
PORT=5180
NODE_ENV=development

# Security: In production, generate a cryptographically strong secret (e.g. `openssl rand -base64 32`)
JWT_SECRET=your_super_secret_jwt_key_here

# Proxy Security: Number of trusted reverse proxy hops (e.g. 1 for Railway/Cloudflare/Vercel)
# Prevents spoofed X-Forwarded-For headers from bypassing rate limiters or forging client IPs
TRUST_PROXY_HOPS=1

# Registration & Course Invite Code
COURSE_INVITE_CODE=CS518-2026

# Admin Role Configuration: Comma-separated list of exact email addresses and usernames granted admin powers
ADMIN_EMAILS=admin@example.com
ADMIN_USERNAMES=admin,core_dev

# CORS: Comma-separated list of allowed frontend production origins
# Localhost, 127.0.0.1, 10.0.2.2 (Android emulator), and Tauri origins (tauri.localhost) are allowed automatically
CLIENT_URL=https://your-app.vercel.app

# Database URI (Use MongoDB Atlas connection string in production; omit in dev for embedded MongoMemoryServer)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/clearfeed?retryWrites=true&w=majority

# Optional: Maintenance purge secret key (required in production to access /api/maintenance/clean)
# MAINTENANCE_SECRET_KEY=your_random_secret_maintenance_key_here

# Google Gemini AI Integration for Clearfeed Learning Mentor & AI Friends
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: LiveKit or TURN Server for High-Scale Audio Spaces & Strict Cellular NAT Traversal
# LIVEKIT_URL=https://your-project.livekit.cloud
# LIVEKIT_API_KEY=your_livekit_key
# LIVEKIT_API_SECRET=your_livekit_secret
# CLOUDFLARE_TURN_KEY_ID=your_cloudflare_turn_key_id
# CLOUDFLARE_TURN_API_TOKEN=your_cloudflare_turn_api_token
# METERED_DOMAIN=your_app.metered.live
# METERED_API_KEY=your_metered_api_key
# TURN_STATIC_SECRET=your_coturn_hmac_secret
# TURN_URLS=turn:relay.clearfeed.app:3478,turns:relay.clearfeed.app:5349
