{
  "name": "@clearfeed/mesh-core",
  "version": "1.0.0",
  "type": "module",
  "description": "Deterministic, audited CFM1 Protocol & Cryptographic Core for Clearfeed Mesh (Web, Android, Windows)",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node test/cfm1Protocol.test.js --input-type=module",
    "clean": "node -e \"try { require('fs').rmSync('dist', { recursive: true, force: true }); } catch (e) {}\""
  },
  "keywords": [
    "clearfeed",
    "mesh",
    "cfm1",
    "ed25519",
    "x25519",
    "chacha20poly1305",
    "ble",
    "cryptography"
  ],
  "author": "Clearfeed Core Engineering",
  "license": "MIT",
  "dependencies": {
    "@noble/ciphers": "^1.2.1",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
