# Clearfeed Web Client Environment Configuration

# In local development, leave this empty to use Vite's built-in /api proxy to http://localhost:5180.
# In production (e.g. Vercel), set to your deployed backend URL or leave empty if using vercel.json rewrites:
# VITE_API_URL=https://your-api.up.railway.app
VITE_API_URL=
